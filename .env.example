# Gere com: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# Domínio público da esteira (sem https://), e a origem completa para o CSRF.
DJANGO_ALLOWED_HOSTS=esteira.exemplo.com.br
DJANGO_CSRF_TRUSTED_ORIGINS=https://esteira.exemplo.com.br

# Senha do Postgres usada pelo docker-compose.yml.
POSTGRES_PASSWORD=

# Fora do compose (EasyPanel, por exemplo), aponte direto para o banco:
# DATABASE_URL=postgres://usuario:senha@host:5432/esteira

# Só para testar a imagem em http://localhost:8000, sem TLS. Nunca em produção.
# DJANGO_HTTPS=0
